<script server>
const appName = process.env.APP_NAME || 'StatusHQ'

// SSO providers, mirroring config/sso.ts's env contract (this view is
// self-contained by the app's convention, so it reads env directly
// rather than importing the config). A provider appears as a button
// only when fully configured.
const ssoProviders = []
if ((process.env.GOOGLE_CLIENT_ID || process.env.SSO_GOOGLE_CLIENT_ID) && (process.env.GOOGLE_CLIENT_SECRET || process.env.SSO_GOOGLE_CLIENT_SECRET))
  ssoProviders.push({ key: 'google', label: 'Google' })
if (process.env.APPLE_CLIENT_ID && process.env.APPLE_TEAM_ID && process.env.APPLE_KEY_ID && process.env.APPLE_PRIVATE_KEY)
  ssoProviders.push({ key: 'apple', label: 'Apple' })
if (process.env.GITHUB_CLIENT_ID && process.env.GITHUB_CLIENT_SECRET)
  ssoProviders.push({ key: 'github', label: 'GitHub' })
if (process.env.SSO_OKTA_ISSUER && process.env.SSO_OKTA_CLIENT_ID && process.env.SSO_OKTA_CLIENT_SECRET)
  ssoProviders.push({ key: 'okta', label: 'Okta' })
if (process.env.SSO_ENTRA_TENANT_ID && process.env.SSO_ENTRA_CLIENT_ID && process.env.SSO_ENTRA_CLIENT_SECRET)
  ssoProviders.push({ key: 'entra', label: 'Microsoft' })
if (process.env.SSO_OIDC_ISSUER && process.env.SSO_OIDC_CLIENT_ID && process.env.SSO_OIDC_CLIENT_SECRET)
  ssoProviders.push({ key: 'oidc', label: process.env.SSO_OIDC_LABEL || 'SSO' })
const hasSso = ssoProviders.length > 0
</script>

@extends('layouts/auth')

@section('title', "Sign in &middot; " + appName)
@section('description', "Sign in to your StatusHQ dashboard.")

@section('content')
    <div class="auth-card">
      <a class="brand" href="/" data-no-router>
        <span class="brand-mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12h3.5l2-5 3 10 2-7 1.5 3.5h6.5"/></svg></span>
        <span class="brand-name">{{ appName }}</span>
      </a>

      <div id="error" class="error"></div>

      <!-- Step 1: credentials -->
      <form id="login-form">
        <h1>Welcome back</h1>
        <p class="sub">Sign in to your {{ appName }} account.</p>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" placeholder="you@yourcompany.com" required>
        </div>
        <div class="field">
          <div class="row-between">
            <label for="password">Password</label>
          </div>
          <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Your password" required>
        </div>
        <button id="login-btn" class="button" type="submit">Sign in</button>

        <div class="sso-divider passkey-divider hide" id="passkey-divider">or</div>
        <div class="sso-buttons">
          <button type="button" id="passkey-btn" class="button sso hide"><span class="sso-icon sso-icon-passkey"></span>Sign in with a passkey</button>
        </div>

        @if (hasSso)
          <div class="sso-divider">or</div>
          <div class="sso-buttons">
            @foreach (ssoProviders as p)
              <a class="button sso" href="/api/auth/sso/{{ p.key }}" data-no-router><span class="sso-icon sso-icon-{{ p.key }}"></span>Continue with {{ p.label }}</a>
            @endforeach
          </div>
        @endif
      </form>

      <!-- Step 2: TOTP (shown only when the account has 2FA enabled) -->
      <form id="twofa-form" class="hide">
        <h1>Two-factor code</h1>
        <p class="sub">Enter the 6-digit code from your authenticator app.</p>
        <div class="field">
          <label for="code">Authentication code</label>
          <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="123456" required>
        </div>
        <button id="twofa-btn" class="button" type="submit">Verify &amp; sign in</button>
      </form>

      <p class="alt">Don't have an account? <a href="/register" data-no-router>Create one</a></p>
    </div>

    <script src="/assets/scripts/webauthn-client.js"></script>
    <script>
      (function () {
        var REDIRECT = '/dashboard'
        var errorEl = document.getElementById('error')
        var loginForm = document.getElementById('login-form')
        var twofaForm = document.getElementById('twofa-form')
        var loginBtn = document.getElementById('login-btn')
        var twofaBtn = document.getElementById('twofa-btn')
        var challengeToken = null

        function readCookie(name) {
          var m = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/[.$?*|{}()\[\]\\\/+^]/g, '\\$&') + '=([^;]*)'))
          return m ? decodeURIComponent(m[1]) : null
        }

        // Double-submit CSRF: the view server doesn't seed the token cookie
        // (only the API router does, on its own GET responses), so a page
        // rendered by `buddy serve` has none. The token isn't a server
        // secret — the middleware just checks that the cookie value equals
        // the echoed header — so the client can safely mint one when absent.
        // Same-origin + SameSite keep a cross-site attacker from forging a
        // matching pair.
        function ensureCsrf() {
          var existing = readCookie('X-CSRF-Token')
          if (existing) return existing
          var arr = new Uint8Array(32)
          window.crypto.getRandomValues(arr)
          var tok = Array.prototype.map.call(arr, function (b) { return ('0' + b.toString(16)).slice(-2) }).join('')
          document.cookie = 'X-CSRF-Token=' + tok + '; Path=/; SameSite=Lax' + (location.protocol === 'https:' ? '; Secure' : '')
          return tok
        }

        function showError(msg) {
          errorEl.textContent = msg
          errorEl.classList.add('show')
        }

        // SSO callback failures land here as /login?error=sso_* (the
        // callback is a full-page navigation, so redirect + query param
        // is its only error channel).
        var ssoError = new URLSearchParams(window.location.search).get('error')
        if (ssoError && ssoError.indexOf('sso_') === 0) {
          var ssoMessages = {
            sso_denied: 'Single sign-on was cancelled.',
            sso_email_unverified: 'Your identity provider reports this email as unverified, so it cannot be linked to an existing account.',
            sso_no_email: 'Your identity provider did not share an email address. Ask your admin to allow the email scope.',
            sso_misconfigured: 'This sign-in method is not fully configured yet. Please use your password or contact support.',
          }
          showError(ssoMessages[ssoError] || 'Single sign-on failed. Please try again or use your password.')
        }
        function clearError() {
          errorEl.textContent = ''
          errorEl.classList.remove('show')
        }

        async function post(url, body) {
          var headers = { 'Content-Type': 'application/json', 'x-csrf-token': ensureCsrf() }
          var res = await fetch(url, {
            method: 'POST',
            headers: headers,
            credentials: 'same-origin',
            body: JSON.stringify(body),
          })
          var data = {}
          try { data = await res.json() } catch (e) {}
          return { ok: res.ok, status: res.status, data: data }
        }

        loginForm.addEventListener('submit', async function (e) {
          e.preventDefault()
          clearError()
          loginBtn.disabled = true
          loginBtn.textContent = 'Signing in…'
          try {
            var r = await post('/login', {
              email: document.getElementById('email').value.trim(),
              password: document.getElementById('password').value,
            })
            if (r.data && r.data.requires_two_factor) {
              challengeToken = r.data.challenge_token
              loginForm.classList.add('hide')
              twofaForm.classList.remove('hide')
              document.getElementById('code').focus()
              return
            }
            if (r.ok && (r.data.token || r.data.access_token)) {
              window.location.href = REDIRECT
              return
            }
            showError((r.data && (r.data.message || r.data.error)) || 'Incorrect email or password.')
          } catch (err) {
            showError('Something went wrong. Please try again.')
          } finally {
            loginBtn.disabled = false
            loginBtn.textContent = 'Sign in'
          }
        })

        twofaForm.addEventListener('submit', async function (e) {
          e.preventDefault()
          clearError()
          twofaBtn.disabled = true
          twofaBtn.textContent = 'Verifying…'
          try {
            var r = await post('/verify-two-factor-login', {
              challenge_token: challengeToken,
              code: document.getElementById('code').value.trim(),
            })
            if (r.ok && (r.data.token || r.data.access_token)) {
              window.location.href = REDIRECT
              return
            }
            showError((r.data && (r.data.message || r.data.error)) || 'Invalid code — please sign in again.')
            // Challenge tokens are single-use; send them back to step 1.
            twofaForm.classList.add('hide')
            loginForm.classList.remove('hide')
          } catch (err) {
            showError('Something went wrong. Please try again.')
          } finally {
            twofaBtn.disabled = false
            twofaBtn.textContent = 'Verify & sign in'
          }
        })

        // Passwordless passkey sign-in. Progressive enhancement: the button
        // is hidden until we confirm the browser supports WebAuthn, so a
        // non-supporting browser just sees the password form.
        var passkeyBtn = document.getElementById('passkey-btn')
        if (passkeyBtn && window.stacksPasskey && window.stacksPasskey.isSupported()) {
          document.getElementById('passkey-divider').classList.remove('hide')
          passkeyBtn.classList.remove('hide')
          passkeyBtn.addEventListener('click', async function () {
            clearError()
            passkeyBtn.disabled = true
            var original = passkeyBtn.textContent
            passkeyBtn.textContent = 'Waiting for your device…'
            try {
              var r = await window.stacksPasskey.login('/api/passkeys/login/options', '/api/passkeys/login/verify', ensureCsrf())
              if (r.ok) {
                window.location.href = REDIRECT
                return
              }
              showError(r.error || 'Could not sign in with a passkey.')
            } catch (err) {
              showError('Something went wrong. Please try again.')
            } finally {
              passkeyBtn.disabled = false
              passkeyBtn.textContent = original
            }
          })
        }
      })()
    </script>
@endsection
