<script server>
const appName = process.env.APP_NAME || 'StatusHQ'

const audiences = [
  {
    title: 'Agencies',
    text: 'Every client site, certificate, and domain in one dashboard, with branded status pages that do the reassuring for you.',
    href: '/for/agencies',
  },
  {
    title: 'SaaS teams',
    text: 'Uptime your customers can verify: public history, automatic incident timelines, and answers that land before the support tickets do.',
    href: '/for/saas',
  },
  {
    title: 'E-commerce',
    text: 'Downtime is lost revenue with a number attached. Watch checkout, payments, and product pages as often as every 30 seconds.',
    href: '/for/ecommerce',
  },
  {
    title: 'DevOps & SRE',
    text: 'Automation-first monitoring: monitors are API records you create from deploy pipelines, with alerts routed to PagerDuty or Opsgenie.',
    href: '/for/devops',
  },
  {
    title: 'Stacks developers',
    text: 'Monitoring that speaks TypeScript. Heartbeat pings from jobs, health-route checks, and a product that is itself a Stacks app.',
    href: '/for/stacks-developers',
  },
  {
    title: 'Compare',
    text: 'How we stack up against Oh Dear, Uptime Kuma, and the rest: features, pricing, and where each tool actually wins.',
    href: '/compare',
  },
]

// SEO tags via the framework head (stx-standards 04): og:title,
// og:description and the twitter pair derive from title/description;
// canonical + og:url go through useHead (the server-side useSeoMeta
// ignores its canonical key in this build).
useSeoMeta({
  title: "Use cases | " + appName,
  description: "Uptime monitoring for agencies, SaaS teams, e-commerce, DevOps, and Stacks developers. See how the open-source StatusHQ fits the way your team works.",
  ogDescription: "Uptime monitoring for agencies, SaaS teams, e-commerce, DevOps, and Stacks developers.",
  ogType: 'website',
})
useHead({
  link: [{ rel: 'canonical', href: "https://statushq.org/for" }],
  meta: [{ property: 'og:url', content: "https://statushq.org/for" }],
})
</script>

@extends('layouts/marketing')

@section('content')
      <section class="site-shell">
